{
  "name": "dsh-game-pet-watch",
  "version": "1.3.0",
  "private": true,
  "description": "盯游戏画面的桌宠大脑：多模态模型决定要不要说话，说就打在桌面宠物气泡上；支持多鱼隔离、记忆压缩、图库、QQ、碰撞台词与跨进程宠物互撞。",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./src/*": "./src/*",
    "./index-*.js": "./index-*.js"
  },
  "files": [
    "index.js",
    "index-*.js",
    "client.js",
    "src",
    "web",
    "cordis.patch.yml",
    "scripts/capture.ps1",
    "scripts/preflight.mjs",
    "scripts/sandbox-first-run.mjs",
    "scripts/sandbox-collide.mjs",
    "scripts/backup-all.mjs",
    "scripts/uninstall-all.mjs",
    "scripts/restore-all.mjs",
    "scripts/install-local.mjs"
  ],
  "scripts": {
    "test": "node tests/first-install.test.mjs && node tests/exports.test.mjs && node tests/fish.test.mjs && node tests/config-store.test.mjs && node tests/images.test.mjs && node tests/memes.test.mjs && node tests/multiline.test.mjs && node tests/collide.test.mjs",
    "preflight": "node scripts/preflight.mjs",
    "sandbox": "node scripts/sandbox-first-run.mjs",
    "sandbox:collide": "node scripts/sandbox-collide.mjs",
    "install-local": "node scripts/install-local.mjs",
    "backup": "node scripts/backup-repo.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
